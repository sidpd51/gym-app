# Copy to .env and fill in. Do not commit .env.
ENV=dev
PORT=8080
DATABASE_URL=mysql://gymuser:dev@localhost:3306/gymdb
JWT_SECRET=change-me-to-a-64-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxxxx
COOKIE_SECRET=change-me-to-a-64-char-random-string-yyyyyyyyyyyyyyyyyyyyyy
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL=8h
LOG_LEVEL=debug
# LOGIN_RATE_LIMIT_MAX=5
BACKUP_DIR=./.backups

# Override the client binaries used by the backup service (default: mysqldump / mysql on PATH).
# MYSQLDUMP_BIN=/usr/local/mysql/bin/mysqldump
# MYSQL_BIN=/usr/local/mysql/bin/mysql

# Dev machine without mysql client tools: run them inside the MySQL container via `docker exec`.
# The server's own docker image ships the client, so compose sets this to 0 there.
# BACKUP_USE_DOCKER_EXEC=1
# BACKUP_DOCKER_CONTAINER=gym-mysql
