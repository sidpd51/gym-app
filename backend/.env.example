# Copy to .env and fill in. Do not commit .env.
ENV=dev
PORT=8080
DATABASE_URL=postgres://gymuser:dev@localhost:5432/gymdb?sslmode=disable
JWT_SECRET=change-me-to-a-64-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxxxx
COOKIE_SECRET=change-me-to-a-64-char-random-string-yyyyyyyyyyyyyyyyyyyyyy
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL=8h
LOG_LEVEL=debug
BACKUP_DIR=./.backups

# If your system has multiple PostgreSQL client versions installed, override
# the binaries that backup.go uses. Required when the server is Postgres 15+
# but the default pg_dump on PATH is older — pg_dump refuses to dump a newer
# server. Leave unset to use whatever is on PATH.
# PGDUMP_BIN=/opt/homebrew/opt/postgresql@15/bin/pg_dump
# PSQL_BIN=/opt/homebrew/opt/postgresql@15/bin/psql
